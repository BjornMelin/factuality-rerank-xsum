[project]
name = "factuality-rerank-xsum"
version = "0.1.0"
description = "XSum factuality-aware reranking project"
readme = "README.md"
requires-python = ">=3.11,<3.13"
dependencies = [
  "transformers==5.5.3",
  "datasets==4.8.4",
  "accelerate==1.13.0",
  "evaluate==0.4.6",
  "peft==0.18.1",
  "sentencepiece==0.2.1",
  "rouge_score>=0.1.2",
  "bert-score>=0.3.13",
  "nltk>=3.9",
  "numpy>=1.26,<3",
  "pandas>=2.2,<3",
  "pyarrow>=17,<20",
  "scikit-learn>=1.5,<2",
  "scipy>=1.13,<2",
  "matplotlib>=3.9,<4",
  "pyyaml>=6.0,<7",
  "jsonlines>=4.0.0,<5",
  "spacy>=3.8,<4",
  "typer>=0.12,<1",
  "rich>=13,<14",
]

[project.optional-dependencies]
metrics = [
  "summac==0.0.4",
]
dev = [
  "jupyterlab",
  "ipykernel",
  "pytest>=8,<9",
  "ruff>=0.6",
]

[tool.uv]
package = false
